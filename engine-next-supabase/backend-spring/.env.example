# Shared from Node.js backend
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
PORT=5000
JWT_SECRET=your_jwt_secret
GROQ_API_KEY=your_groq_api_key
MODEL_NAME=llama-3.3-70b-versatile
NODE_ENV=development

# Spring Boot JDBC connection via Supabase Pooler
DATABASE_URL=jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:5432/postgres?user=postgres.YOUR_PROJECT_REF&password=YOUR_DB_PASSWORD&sslmode=require&prepareThreshold=0

# CORS — set to your Vercel frontend URL in production
CORS_ORIGINS=http://localhost:3000
